COMPOSE_PROJECT_NAME=refugee-spar

# Host ports
SPAR_POSTGRES_PORT=5735
SPAR_MAPPER_PORT=8390
SPAR_BENE_PORT=8391

# Dedicated SPAR Postgres
SPAR_DB_USER=sparuser
SPAR_DB_PASSWORD=__CHANGE_ME__
SPAR_DB_NAME=spardb

# Optional read-only PostgreSQL DSN to Refugee-Registry (e.g. postgresql://pbms_reader:<pass>@localhost:5535/refugee_registry_db)
# Leave blank if seeding from fixtures/demo-ids.csv (SEED_FROM_FIXTURE=true).
REGISTRY_RO_DSN=

# Fictional bank mapping defaults
SPAR_BANK_CODE=EXAMPLE-BANK
SPAR_BRANCH_CODE=MAIN
SEED_FROM_FIXTURE=false
